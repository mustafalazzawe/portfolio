---
import "../styles/tokens.css";
import "../styles/reset.css";
import "../styles/globals.css";
import Background from "../components/Background.astro";
import Footer from "../components/Sections/Footer.astro";

interface Props {
  title?: string;
}

const { title = "Mustafa Al-Azzawe | Frontend Developer & Designer" } =
  Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Franklin:ital,wght@0,100..900;1,100..900&family=Lora:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body>
    <Background />
    <slot />
  </body>

  <Footer />
</html>

<style is:global>
  body {
    position: relative;
    min-height: 100vh;
  }

  section,
  footer {
    display: flex;
    flex-direction: column;
    align-items: center;

    padding: var(--spacing-64) var(--spacing-128);
  }

  section .container {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-16);

    width: 100%;
    max-width: var(--width-3xl);
  }

  footer .container {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-32);

    width: 100%;
    max-width: var(--width-3xl);
  }

  @media (max-width: 1280px) {
    section,
    footer {
      padding: var(--spacing-32) var(--spacing-64);
    }
  }

  @media (max-width: 1024px) {
    section,
    footer {
      padding: var(--spacing-16) var(--spacing-32);
    }

    section .container {
      gap: var(--spacing-12);
    }

    footer .container {
      gap: var(--spacing-32);
    }
    
    footer {
      margin-top: var(--spacing-16);
    }
  }

  @media (max-width: 480px) {
    section,
    footer {
      padding: var(--spacing-16);
    }
  }
</style>
