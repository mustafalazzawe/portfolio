---
import ProjectCard from "./ProjectCard.astro";
---

<section id="projects" class="projects">
  <div class="container">
    <h2 class="projects__title">Projects</h2>
    <div class="projects__section projects__development">
      <h5 class="projects__section__title">Development</h5>
      <div class="projects__cards">
        <ProjectCard />
        <div class="divider"/>
        <ProjectCard />
        <div class="divider"/>
        <ProjectCard />
      </div>
    </div>
    <div class="projects__section projects__design">
      <h5 class="projects__section__title">Design</h5>
      <div class="projects__cards">
        <ProjectCard />
        <div class="divider"/>
        <ProjectCard />
        <div class="divider"/>
        <ProjectCard />
      </div>
    </div>
  </div>
</section>

<style>
  .container {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-24);
  }

  .projects__section {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-16);
  }

  .projects__cards {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-12);
  }

  .divider {
    height: 1px;
    background-color: var(--border-secondary);
  }
</style>
