---
import type { TProject } from "./Sections/Projects.astro";
import Tag from "./Tag.astro";

interface Props extends TProject {}

const { type, status, title, description, tags } = Astro.props;
---

<div class="project__container">
  <div class="project__thumbnail"></div>
  <div class="project__info">
    <div class="project__body">
      <div class="project__text">
        <p class="text-body-header project__title">{title}</p>
        <p class="project__description">
          {description}
        </p>
      </div>
      <div class="project__tags">
        {tags.map((tag) => <Tag label={tag} />)}
      </div>
    </div>
    <div class="project__actions">
      <button class="interactive btn btn-primary">View Project</button>
    </div>
  </div>
</div>

<style>
  .project__container {
    display: flex;
    gap: var(--spacing-12);
  }

  @media (max-width: 1024px) {
    .project__container {
      flex-direction: column;
    }
  }

  .project__thumbnail {
    width: var(--width-md);
    min-width: 40%;
    align-self: stretch;

    border-radius: var(--b-radius-xl);
    background: rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 1024px) {
    .project__thumbnail {
      width: 100%;
      height: 50vw;
    }
  }

  .project__info {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-16);
  }

  .project__body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
  }

  .project__text {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }

  .project__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-4);
  }
</style>
