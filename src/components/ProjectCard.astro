---
import { Image } from "astro:assets";
import Icon from "./Icons/Icon.astro";
import Tag from "./Tag.astro";
import type { TProject } from "./Sections/Projects.astro";

interface Props extends TProject {
  index?: number;
}

const {
  title,
  description,
  tags,
  thumbnail,
  repoURL,
  liveURL,
  index = 0,
} = Astro.props;
---

<div class="project__container">
  <div class="project__thumbnail">
    {
      thumbnail &&
        (index === 0 ? (
          <Image
            class="project__thumbnail__img"
            src={thumbnail}
            alt={title}
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <Image
            class="project__thumbnail__img"
            src={thumbnail}
            alt={title}
            loading="lazy"
            decoding="async"
          />
        ))
    }
  </div>
  <div class="project__info">
    <div class="project__body">
      <div class="project__text">
        <span class="project__header">
          {
            liveURL ? (
              <a
                href={liveURL}
                target="_blank"
                rel="noopener noreferrer"
                class="interactive project__title-link"
              >
                <span class="project__link-overlay" />
                {title}
              </a>
            ) : (
              <p class="project__title">{title}</p>
            )
          }
          {
            liveURL && (
              <span class="project__arrow">
                <Icon name="arrow-up-right" size={20} />
              </span>
            )
          }
        </span>
        <p class="project__description">
          {description}
        </p>
      </div>

      <div class="project__tags">
        {tags.map((tag) => <Tag label={tag} />)}
      </div>
    </div>

    <div class="project__actions">
      {
        repoURL && (
          <a
            href={repoURL}
            target="_blank"
            rel="noopener noreferrer"
            class="interactive btn btn-label"
          >
            View Github <Icon name="github-alt" size={20} />
          </a>
        )
      }
    </div>
  </div>
</div>

<style>
  .project__container {
    position: relative;

    display: flex;
    gap: var(--spacing-12);

    padding: var(--spacing-12);
    margin-inline: calc(-1 * var(--spacing-12));

    border-radius: var(--b-radius-2xl);

    isolation: auto;

    transition:
      opacity 0.3s ease,
      transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .project__container::before {
    content: "";

    position: absolute;
    inset: 0;

    border-radius: inherit;

    background-color: rgba(20, 27, 35, 0.2);

    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);

    box-shadow:
      0px 4px 8px 0px rgba(0, 0, 0, 0.11),
      0px 2px 4px 0px rgba(0, 0, 0, 0.07),
      inset 0px 1px 0px 0px rgba(176, 181, 188, 0.12);

    opacity: 0;

    transition: opacity 0.3s ease;
    pointer-events: none;
    z-index: -1;
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 481px) {
    .project__container:hover {
      transform: scale(1.005);
    }

    .project__container:hover::before {
      opacity: 1;
    }

    .project__container:active {
      transform: scale(0.995);
      transition:
        opacity 0.3s ease,
        transform 0.15s cubic-bezier(0.22, 1, 0.36, 1);
    }

    :global(.project__cards:has(.project__container:hover))
      .project__container:not(:hover) {
      opacity: 0.4;
    }
  }

  @media (max-width: 1024px) {
    .project__container {
      flex-direction: column;
    }
  }

  .project__thumbnail {
    position: relative;
    overflow: hidden;

    flex-shrink: 0;
    width: 224px;
    height: 128px;

    border-radius: var(--b-radius-lg);
    border: 1px solid var(--border-secondary);

    transition: border-color 0.3s ease;
  }

  .project__container:has(.project__title-link):hover .project__thumbnail,
  .project__container:has(.project__title-link):active .project__thumbnail {
    border-color: var(--border-primary);
  }

  .project__thumbnail__img {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }

  .project__info {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-16);
  }

  .project__body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
  }

  .project__text {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }

  .project__header {
    display: flex;
    align-items: center;
    gap: var(--spacing-6);
  }
  .project__container:has(.project__title-link):hover .project__header,
  .project__container:has(.project__title-link):hover .project__header:active {
    color: var(--interactive-foreground);
  }

  .project__title-link {
    min-height: 0;

    text-decoration: none;
    color: inherit;
  }

  .project__link-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;

    border-radius: var(--b-radius-2xl);
  }

  .project__arrow {
    display: flex;

    transition:
      transform 0.3s ease,
      color 0.1s ease;
  }

  .project__container:hover .project__arrow,
  .project__container:active .project__arrow {
    transform: translate(2px, -2px);
  }

  .project__description {
    color: var(--fg-secondary);
  }

  .project__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-4);
  }

  .project__actions {
    position: relative;

    display: flex;
  }

  .project__actions a {
    position: relative;
    z-index: 2;

    text-decoration: none;
  }
</style>
