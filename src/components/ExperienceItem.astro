---
interface Props {
  period: { start: string; end?: string };
  role: string;
  company: string;
  description: string;
}

const { period, role, company, description } = Astro.props;
---

<article class="timeline__item">
  <div class="timeline__indicator">
    <div class="timeline__dot"></div>
    <span class="text-body-header experience__period">
      <time datetime={period.start}>{period.start}</time>
      -
      {period.end ? <time datetime={period.end}>{period.end}</time> : `Present`}
    </span>
  </div>
  <div class="experience__info">
    <h5 class="experience__role">{role}</h5>
    <p class="text-body-lg experience__company">{company}</p>
    <p class="experience__description">
      {description}
    </p>
  </div>
</article>

<style>
  :root {
    --timeline-dot-size: 16px;
  }
  .timeline__item {
    display: grid;
    grid-template-columns: 200px 1fr;
    align-items: flex-start;
    gap: var(--spacing-128);
  }

  @media (max-width: 1280px) {
    .timeline__item {
      gap: var(--spacing-32);
    }
  }
  @media (max-width: 1024px) {
    .timeline__item {
      gap: var(--spacing-16);
    }
  }
  @media (max-width: 768px) {
    .timeline__item {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  .timeline__indicator {
    position: sticky;

    top: var(--spacing-16);

    display: flex;
    align-items: center;
    gap: var(--spacing-4);
  }

  @media (max-width: 768px) {
    .timeline__indicator {
      position: static;
    }
  }

  .timeline__dot {
    width: var(--timeline-dot-size);

    aspect-ratio: 1/1;

    border-radius: var(--b-radius-full);
    border: var(--b-width-lg) solid var(--color-primary-800);

    background-color: var(--interactive-primary);

    z-index: 1;
  }

  .experience__period {
    display: inline;
    white-space: nowrap;
  }

  .experience__info {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
  }

  @media (max-width: 768px) {
    .experience__info {
      padding-left: calc(var(--timeline-dot-size) + var(--spacing-4));
    }
  }

  .experience__company {
    color: var(--fg-secondary);
  }
</style>
