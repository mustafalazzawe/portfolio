<canvas class="canvas" aria-hidden="true"></canvas>

<style>
  .canvas {
    display: block;
    width: 100%;
    height: 100%;

    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .canvas.loaded {
    opacity: 1;
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>(".canvas")!;

  // Mobile heuristic: coarse pointer (touch) OR narrow viewport.
  // On these devices, antialiasing is expensive and barely visible.
  const isMobile =
    matchMedia("(pointer: coarse)").matches || window.innerWidth < 768;

  // Lazy-load the entire Three.js bundle.
  // Vite code-splits this into a separate chunk that is only
  // fetched when this import() executes, keeping the initial page load fast.
  import("../lib/three/init")
    .then(({ initCanvas }) => {
      initCanvas(canvas, { antialias: !isMobile });
    })
    .catch((err) => {
      console.error("[Canvas] Failed to load Three.js init chunk:", err);
    });
</script>
