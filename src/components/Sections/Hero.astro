---
import Canvas from "../Canvas.astro";
---

<section id="home" class="hero">
  <div class="container">
    <div class="hero__layout">
      <div class="hero__content">
        <div class="hero__header">
          <h4 class="hero__greeting">Hi, I'm Mustafa</h4>
          <h2 class="hero__title">Design Engineer</h2>
        </div>

        <div class="hero__body">
          <p class="hero__description">
            I build clean, accessible experiences where every detail is
            intentional.
          </p>
          <p class="hero__description">
            I co-founded <a href="https://everythingincreation.com/" target="_blank" rel="noopener noreferrer">Everything in Creation</a>, a design and development agency,
            and currently consult as a Design Engineer at <a href="https://www.humra.love/" target="_blank" rel="noopener noreferrer">HUMRĀ</a>.
          </p>
        </div>
      </div>

      <div class="hero__canvas">
        <Canvas />
      </div>
    </div>
  </div>
</section>

<style>
  .hero__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-24);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-24);

    align-self: start;
    max-width: var(--width-xl);
  }

  .hero__header {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-0);
  }

  .hero__greeting {
    color: var(--fg-secondary);
  }

  .hero__body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
  }

  .hero__description {
    color: var(--fg-secondary);
  }

  .hero__actions {
    display: flex;
    gap: var(--spacing-4);
  }

  .hero__canvas {
    width: min(480px, 100%);
    aspect-ratio: 1;

    margin: 0 auto;
  }

  @media (max-width: 1024px) {
    .hero__layout {
      grid-template-columns: 1fr;
    }
  }
</style>
