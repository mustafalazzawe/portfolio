---
import Canvas from "../Canvas.astro";
import Icon from "../Icons/Icon.astro";
import Tooltip from "../Tooltip.astro";
---

<section id="home" class="hero">
  <div class="container">
    <div class="hero__layout">
      <div class="hero__content">
        <div class="hero__text">
          <div class="hero__header">
            <h4 class="hero__greeting">Mustafa Al-Azzawe</h4>
            <h2 class="hero__title">Design Engineer</h2>
          </div>
          <div class="hero__body">
            <p class="hero__description">
              I build clean, accessible experiences where every detail is
              intentional.
            </p>
          </div>
        </div>

        <div class="hero__actions tooltip-group">
          <Tooltip label="Github">
            <a
              href="https://github.com/mustafalazzawe"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub"
            >
              <Icon name="github-alt" size={24} />
            </a>
          </Tooltip>
          <Tooltip label="Twitter/X">
            <a
              href="https://x.com/mustafalazzawe_"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="X"
            >
              <Icon name="x-logo" size={24} />
            </a>
          </Tooltip>
          <Tooltip label="LinkedIn">
            <a
              href="https://www.linkedin.com/in/mustafa-al-azzawe-147a981a9/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
            >
              <Icon name="linkedin" size={24} />
            </a>
          </Tooltip>
          <Tooltip label="Resume">
            <a
              href="/resume.pdf"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Resume"
            >
              <Icon name="resume" size={24} />
            </a>
          </Tooltip>
        </div>
      </div>

      <div class="hero__canvas">
        <Canvas />
      </div>
    </div>
  </div>
</section>

<style>
  .hero__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-24);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-24);

    align-self: start;
    max-width: var(--width-xl);
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-12);
  }

  .hero__header {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-0);
  }

  .hero__greeting {
    color: var(--fg-secondary);
  }

  .hero__body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
  }

  .hero__description {
    max-width: 32ch;
    color: var(--fg-secondary);
  }

  .hero__actions {
    display: flex;
    gap: var(--spacing-8);
  }

  .hero__actions a {
    padding: var(--spacing-8) 0;

    text-decoration: none;

    transition: transform 140ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .hero__actions a:active {
    transform: scale(0.9);
  }

  .hero__canvas {
    width: min(480px, 100%);
    aspect-ratio: 1;

    margin: 0 auto;
  }

  @media (max-width: 1024px) {
    .hero__layout {
      grid-template-columns: 1fr;
    }
  }
</style>
