      </div>
    </div>
  </div>
</section>

<style>
  .hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-24);

    max-width: var(--width-xl);
  }

  .hero__header {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-0);
  }

  .hero__greeting {
    color: var(--fg-secondary);
  }

  .hero__body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
  }

  .hero__description {
    color: var(--fg-secondary)
  }

  .hero__actions {
    display: flex;
    gap: var(--spacing-4);
  }
</style>
