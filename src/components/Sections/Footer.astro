---
import Icon from "../Icons/Icon.astro";
---

<footer>
  <div class="container">
    <div class="footer__info">
      <span class="footer__location">
        Based in
        <span class="icon__wrapper">
          <Icon name="maple-leaf" size={20} fill="#FF0000" />
        </span>
        Toronto, Ontario, Canada
      </span>
      <span class="footer__copyright">
        &copy; {new Date().getFullYear()} Mustafa Al-Azzawe
      </span>
    </div>
  </div>
</footer>

<style>
  footer {
    width: 100%;

    background-color: var(--bg-primary);
  }

  .footer__info {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  @media (max-width: 768px) {
    .footer__info {
      flex-direction: column;
      align-items: center;
      gap: var(--spacing-20);
    }
  }

  .footer__location {
    display: inline;
  }

  .icon__wrapper {
    padding-inline: var(--spacing-1);
  }
</style>
