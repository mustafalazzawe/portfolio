---
import ExperienceItem from "../ExperienceItem.astro";
---

<section id="experience" class="experience">
  <div class="container">
    <h2 class="experience__title">Experience</h2>
    <div class="experience__body">
      <div class="timeline__line__container">
        <div class="timeline__line"></div>
        <div id="timeline-progress" class="timeline__line timeline__line--progress"></div>
      </div>
      <div class="timeline__items">
        <ExperienceItem
          period={{ start: "2021", end: "2022" }}
          role="Software Developer"
          company="3D CityScapes"
          description="Developed web applications for real estate visualization with real-time data integration. Created responsive frontends and designed user interfaces for interactive property preview systems."
        />
        <ExperienceItem
          period={{ start: "2022", end: "2023" }}
          role="Software Developer"
          company="NTRY GTA"
          description="Led frontend development for interactive residential applications, working closely with design teams to create user-centered interfaces. Built reusable component libraries and established UI/UX workflows from Figma through to production."
        />
        <ExperienceItem
          period={{ start: "2024" }}
          role="Software Developer"
          company="MetaWorld X"
          description="Built a full-stack environmental monitoring application with real-time 3D visualization and responsive interfaces. Developed backend APIs and integrated them with interactive UI components for air quality management systems."
        />
      </div>
    </div>
  </div>
</section>

<style>
  .experience__body {
    position: relative;
  }

  .timeline__line__container {
    position: absolute;

    display: flex;
    justify-content: center;

    width: 16px;
    height: 100%;

    mask-image: linear-gradient(to bottom, transparent 0%, black 10%, black 90%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 10%, black 90%, transparent 100%);
  }

  .timeline__line {
    position: absolute;

    width: 2px;
    height: 100%;
  }

  .timeline__line:not(.timeline__line--progress) {
    background-color: var(--border-secondary);
    z-index: 0;
  }

  .timeline__line--progress {
    background-color: var(--interactive-primary);
    z-index: 0; 

    transform-origin: top;
    transform: scaleY(0); 
  }

  .timeline__items {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-24);

    margin: var(--spacing-8) 0;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initTimeline() {
    const section = document.querySelector('.experience__body');
    const progressLine = document.getElementById('timeline-progress');

    if (!section || !progressLine) return;

    gsap.to(progressLine, {
      scaleY: 1, 
      ease: "none", 
      scrollTrigger: {
        trigger: section,
        start: "top center", 
        end: "bottom center", 
        scrub: 0.75, 
        markers: false 
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initTimeline);
  document.addEventListener('astro:page-load', initTimeline);
</script>