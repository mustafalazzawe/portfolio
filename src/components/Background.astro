---

---

<div class="background">
  <div class="background__glows"></div>
  <div class="background__noise"></div>
</div>

<style>
  .background {
    position: absolute;
    inset: 0;

    overflow: hidden;

    pointer-events: none;
    z-index: -1;
  }

  .background__glows {
    position: absolute;
    inset: 0;

    background-image:
      radial-gradient(
        circle 1280px at calc(100% + 256px) -256px,
        rgba(39, 66, 86, 0.2) 0%,
        rgba(39, 66, 86, 0.15) 20%,
        rgba(39, 66, 86, 0) 70%
      ),
      radial-gradient(
        circle 1280px at -256px 864px,
        rgba(139, 164, 181, 0.1) 0%,
        rgba(139, 164, 181, 0.07) 30%,
        rgba(139, 164, 181, 0) 70%
      ),
      radial-gradient(
        circle 1400px at calc(100% + 128px) 2464px,
        rgba(39, 66, 86, 0.2) 0%,
        rgba(39, 66, 86, 0.15) 30%,
        rgba(39, 66, 86, 0) 70%
      ),
      radial-gradient(
        circle 1280px at -256px 4128px,
        rgba(139, 164, 181, 0.1) 0%,
        rgba(139, 164, 181, 0.07) 30%,
        rgba(139, 164, 181, 0) 70%
      );

    z-index: -2;
  }

  @media (max-width: 768px) {
    .background__glows {
      background-image:
        radial-gradient(
          circle 768px at calc(100% + 128px) -128px,
          rgba(39, 66, 86, 0.2) 0%,
          rgba(39, 66, 86, 0.15) 30%,
          rgba(39, 66, 86, 0) 70%
        ),
        radial-gradient(
          circle 768px at -128px 864px,
          rgba(139, 164, 181, 0.1) 0%,
          rgba(139, 164, 181, 0.07) 30%,
          rgba(139, 164, 181, 0) 70%
        ),
        radial-gradient(
          circle 884px at calc(100% + 64px) 2464px,
          rgba(39, 66, 86, 0.2) 0%,
          rgba(39, 66, 86, 0.15) 30%,
          rgba(39, 66, 86, 0) 70%
        ),
        radial-gradient(
          circle 768px at -128px 4128px,
          rgba(139, 164, 181, 0.1) 0%,
          rgba(139, 164, 181, 0.07) 30%,
          rgba(139, 164, 181, 0) 70%
        );
    }
  }

  .background__noise {
    position: fixed;
    inset: 0;

    background-image: url("/images/noise-200x200.png");
    background-repeat: repeat;

    opacity: 0.3;

    pointer-events: none;
    z-index: -1;
  }

  @media (max-width: 376px) {
    .background__noise {
      background-image: none;
      background-color: rgba(255, 255, 255, 0.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .background__noise {
      background-image: none;
      background-color: rgba(255, 255, 255, 0.04);
    }
  }
</style>
