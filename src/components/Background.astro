<svg style="position: absolute; width: 0; height: 0;">
  <filter id="noise">
    <feTurbulence
      type="fractalNoise"
      baseFrequency="0.8"
      numOctaves="3"
      seed="4368"
    >
    </feTurbulence>
    <feComponentTransfer>
      <feFuncA type="table" tableValues="0 0.1"></feFuncA>
    </feComponentTransfer>
  </filter>
</svg>

<div class="noise"></div>

<div class="glow-layer">
  <div class="glow glow-1"></div>
  <!-- <div class="glow glow-2"></div> -->
  <!-- <div class="glow glow-3"></div> -->
  <!-- <div class="glow glow-4"></div> -->
</div>

<style>
  .noise {
    position: fixed;
    inset: 0;
    filter: url(#noise);
    pointer-events: none;
    z-index: -1;
  }

  .glow {
    position: fixed;
    border-radius: var(--b-radius-full);
    filter: blur(256px);
    pointer-events: none;
    z-index: -2;
  }

  .glow-1 {
    width: 1024px;
    height: 1024px;
    background: rgba(39, 66, 86, 0.2);
    top: -25%;
    right: -10%;
  }

  .glow-2 {
    width: 512px;
    height: 512px;
    /* background: rgba(139, 164, 181, 0.07); */
    background: red;
    left: 10%;
    top: 85%; /* Position relative to viewport */
  }

  .glow-3 {
    width: 512px;
    height: 512px;
    /* background: rgba(39, 66, 86, 0.2); */
    background: blue;
    right: 10%;
    top: 5%;
  }

  .glow-4 {
    width: 569px;
    height: 569px;
    /* background: rgba(39, 66, 86, 0.15); */
    background: orange;
    left: 50%;
    top: 55%;
    transform: translate(-50%, -50%);
  }
</style>
