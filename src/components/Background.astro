---

---

<div class="background__container">
  <svg style="position: absolute; width: 0; height: 0;">
    <filter id="noise">
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.8"
        numOctaves="2"
        seed="4368"
      >
      </feTurbulence>
      <feComponentTransfer>
        <feFuncA type="table" tableValues="0 0.1"></feFuncA>
      </feComponentTransfer>
    </filter>
  </svg>

  <div class="noise"></div>

  <div class="glow glow-1"></div>
  <div class="glow glow-2"></div>
  <div class="glow glow-3"></div>
  <div class="glow glow-4"></div>
</div>

<style>
  .background__container {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: -1;
  }

  .noise {
    position: fixed;
    inset: 0;
    filter: url(#noise);
    pointer-events: none;
    z-index: -1;
  }

  @media (max-width: 376px) {
    .noise {
      filter: none;
      background: rgba(255, 255, 255, 0.04);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .noise {
      filter: none;
      background: rgba(255, 255, 255, 0.04);
    }
  }

  @media not all and (min-resolution: 0.001dpcm) {
    @supports (-webkit-touch-callout: none) {
      .noise {
        filter: none;
        background: rgba(255, 255, 255, 0.04);
      }
    }
  }

  .glow {
    position: absolute;

    width: 75vw;
    max-width: 1024px;
    min-width: 376px;

    aspect-ratio: 1/1;

    border-radius: var(--b-radius-full);

    filter: blur(256px);

    pointer-events: none;
    z-index: -2;
  }

  .glow-1 {
    top: -256px;
    right: -256px;

    background: rgba(39, 66, 86, 0.2);
  }

  .glow-2 {
    top: 864px;
    left: -256px;

    background: rgba(139, 164, 181, 0.1);
  }

  .glow-3 {
    top: 2464px;
    right: -128px;

    width: 85vw;
    max-width: 1256px;

    background: rgba(39, 66, 86, 0.2);
  }

  .glow-4 {
    top: 4128px;
    left: -256px;
    background: rgba(139, 164, 181, 0.1);
  }

  @media (max-width: 768px) {
    .glow {
      filter: blur(128px);
    }
  }
</style>
