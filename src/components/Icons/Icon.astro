---
import type {
  IIconComponentProps,
  TIconComponent,
  TIconName,
} from "./Icon.types";

import ArrowUpRight from "./src/ArrowUpRight.astro";
import Github from "./src/Github.astro";
import GithubAlt from "./src/GithubAlt.astro";
import MapleLeaf from "./src/MapleLeaf.astro";

interface Props extends IIconComponentProps {}

const { name, size = 24, fill = "currentColor" } = Astro.props;

const icons: Record<TIconName, TIconComponent> = {
  "arrow-up-right": ArrowUpRight,
  "github": Github,
  "github-alt": GithubAlt,
  "maple-leaf": MapleLeaf,
};

const IconComponent = icons[name];
---

<IconComponent size={size} fill={fill} />
