---

---

<section id="home" class="hero">
  <div class="glow hero__glow"></div>
  <div class="container">
    <div class="hero__content">
      <div class="hero__header">
        <h4 class="hero__greeting">Hi, I'm Mustafa</h4>
        <h1 class="hero__title">Frontend Developer & Designer</h1>
      </div>

      <div class="hero__body">
        <p class="hero__description">
          I build things at the intersection of code and design.
        </p>
        <p class="hero__description">
          I'm a frontend developer who cares as much about how interfaces look
          and feel as I do about the code behind them. I make things that work
          well and look good.
        </p>
      </div>

      <div class="hero__actions">
        <button class="interactive btn btn-primary">View projects</button>
        <button class="interactive btn btn-secondary">Get in touch</button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-24);

    max-width: var(--width-xl);
  }

  .hero__header {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
  }

  .hero__greeting {
    color: var(--fg-secondary);
  }

  .hero__body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
  }

  .hero__actions {
    display: flex;
    gap: var(--spacing-4);
  }
</style>
